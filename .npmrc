# React is pinned to 19.x while @grafana/* packages still declare react@^18 as a
# peer dependency (Grafana core has not yet widened the range). React is provided
# by the host Grafana at runtime (externalized in .config/bundler/externals.ts),
# so the package.json React version is compile/type-time only and the peer
# mismatch is benign. legacy-peer-deps lets `npm install` / `npm ci` resolve it.
legacy-peer-deps=true
